  <DataSources>
    <DataSource Name="DataStrata_Healthcare_DS">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLexpress;Initial Catalog=DataStrata_Healthcare</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>d6ca8877-620e-4c65-ba4f-00e3af7a0352</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataStrata_Healthcare_DS</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT 
    facility_name,
    state,
    city_town,
    condition_short,
    excess_readmission_ratio,
    performance_tier
FROM readmission_data
WHERE suppressed_flag = 'None'
ORDER BY state, facility_name;</CommandText>
      </Query>
      <Fields>
        <Field Name="facility_name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>facility_name</DataField>
        </Field>
        <Field Name="state">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>state</DataField>
        </Field>
        <Field Name="city_town">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>city_town</DataField>
        </Field>
        <Field Name="condition_short">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>condition_short</DataField>
        </Field>
        <Field Name="excess_readmission_ratio">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>excess_readmission_ratio</DataField>
        </Field>
        <Field Name="performance_tier">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>performance_tier</DataField>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!state.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!State.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="StateList">
      <Query>
        <DataSourceName>DataStrata_Healthcare_DS</DataSourceName>
        <CommandText>SELECT DISTINCT state
FROM readmission_data
ORDER BY state;</CommandText>
      </Query>
      <Fields>
        <Field Name="state">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>state</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
