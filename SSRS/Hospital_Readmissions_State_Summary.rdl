  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLexpress;Initial Catalog=DataStrata_Healthcare</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>9af11cfb-c6ee-4ed3-a729-420eae56506a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT 
    state,
    condition_short,
    COUNT(DISTINCT facility_id_clean)    AS hospital_count,
    AVG(excess_readmission_ratio)        AS avg_err,
    MIN(excess_readmission_ratio)        AS best_err,
    MAX(excess_readmission_ratio)        AS worst_err,
    SUM(CASE WHEN excess_readmission_ratio &gt; 1.0 
        THEN 1 ELSE 0 END)               AS hospitals_penalized
FROM readmission_data
WHERE suppressed_flag = 'None'
GROUP BY state, condition_short
ORDER BY state, condition_short;</CommandText>
      </Query>
      <Fields>
        <Field Name="state">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>state</DataField>
        </Field>
        <Field Name="condition_short">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>condition_short</DataField>
        </Field>
        <Field Name="hospital_count">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>hospital_count</DataField>
        </Field>
        <Field Name="avg_err">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>avg_err</DataField>
        </Field>
        <Field Name="best_err">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>best_err</DataField>
        </Field>
        <Field Name="worst_err">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>worst_err</DataField>
        </Field>
        <Field Name="hospitals_penalized">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>hospitals_penalized</DataField>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!state.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!State.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="StateList">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT state
FROM readmission_data
ORDER BY state;</CommandText>
      </Query>
      <Fields>
        <Field Name="state">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>state</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
