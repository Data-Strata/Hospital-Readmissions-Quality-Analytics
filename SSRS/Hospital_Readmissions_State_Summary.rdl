                                  <Style>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>0.0000;(0.0000)</Format>
                                    <Color>=IIF(Fields!avg_err.Value &gt; 1.0, "DarkRed", "Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
